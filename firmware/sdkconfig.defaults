# Мінімальні налаштування для детермінованої роботи ISR модуляції.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ISR модуляції має жити в IRAM, щоб операції з flash не додавали джитер.
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_MCPWM_ISR_IRAM_SAFE=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y

# Watchdog не повинен глушити систему на етапі налагодження силової частини,
# але й не повинен бути вимкнений у робочій прошивці.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
